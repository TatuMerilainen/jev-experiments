# Copy to .env and fill in. The server reads this file at start.
TYPESAFE_API_KEY=
# Optional. The model for a request that names none. Each Jev player picks its own model in the UI.
# Defaults to jev-1.14.0. Use a fixed version: an alias such as jev-latest can move to a new version.
# TYPESAFE_DEFAULT_MODEL=jev-1.14.0
# Optional. Defaults to 5173.
# PORT=5173
# Optional. The address the server listens on. Defaults to 127.0.0.1, so only this machine can reach it.
# 0.0.0.0 opens it to the network: anyone there can then start paid Jev requests.
# HOST=127.0.0.1
