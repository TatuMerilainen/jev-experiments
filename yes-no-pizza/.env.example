# Copy to .env and fill in. The server reads this file at start.
TYPESAFE_API_KEY=
# Optional. Defaults to jev-1.14.0. Use a fixed version: an alias such as jev-latest can move to a new version.
# TYPESAFE_MODEL=jev-1.14.0
# Optional. Defaults to 5174, so the tabletop game runner (5173) can run at the same time.
# PORT=5174
# Optional. The address the server listens on. Defaults to 127.0.0.1, so only this machine can reach it.
# HOST=127.0.0.1
